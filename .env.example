# Microsoft 365 integration configuration.
# Copy to `.env.local` for development (gitignored). Values are PUBLIC
# identifiers (SPA client IDs are not secrets) — real production values live
# in `.env.production` once IT issues the app registration.

# Entra ID app registration (from IT — see docs/it-request-m365.md).
# Leave unset to run the app with Microsoft integration fully disabled
# (identical to the pre-M365 app).
VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT_ID=

# Set to 1 to run against the in-memory mock Graph tenant (no Microsoft
# account or app registration needed) — used for development and testing
# while the IT request is pending. Dev only; ignored in production builds.
VITE_GRAPH_MOCK=
